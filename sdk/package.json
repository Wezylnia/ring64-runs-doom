{
  "name": "ring64",
  "version": "0.2.0",
  "private": true,
  "description": "The fastest x86 and x86-64 CPU emulator for JavaScript runtimes",
  "keywords": [
    "x86",
    "x86-64",
    "emulator",
    "cpu-emulator",
    "webassembly",
    "wasm",
    "memory64",
    "dynamic-binary-translation"
  ],
  "homepage": "https://ring64.fatihguzel.dev/",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./parallel": {
      "types": "./machine.d.ts",
      "import": "./machine.js"
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "*.wasm",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fatihguzeldev/ring64.git"
  }
}
