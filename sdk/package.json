{
  "name": "ring64",
  "version": "0.1.1",
  "private": true,
  "description": "An x86 and x86-64 CPU emulator for JavaScript runtimes",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./parallel": {
      "types": "./machine.d.ts",
      "import": "./machine.js"
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "*.wasm"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fatihguzeldev/ring64.git"
  }
}
