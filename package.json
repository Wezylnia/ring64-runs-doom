{
  "name": "ring64",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "cargo fmt && prettier --write .",
    "format:check": "cargo fmt --check && prettier --check .",
    "test": "node --import tsx --test \"sdk/tests/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:package": "node --test sdk/tests/package/package.test.mjs",
    "test:browser": "node scripts/check/browser-check.mjs",
    "test:parallel": "node --import tsx --test tests/runners/parallel-node.test.ts",
    "test:parallel:mutations": "node scripts/check/parallel-mutations/parallel-mutation-check.mjs",
    "test:browser:parallel": "node scripts/check/parallel-browser-check.mjs",
    "check": "npm run format:check && npm run lint && cargo clippy --all-targets -- -D warnings && cargo clippy --target wasm32-unknown-unknown --lib -- -D warnings && cargo clippy --target wasm32-unknown-unknown --lib --features parallel -- -D warnings && cargo test --locked && npm run build && npm test && npm run test:browser && npm run test:browser:parallel && npm run test:package",
    "bench": "node scripts/bench/benchmark.mjs",
    "bench:parallel": "node scripts/bench/parallel-bench.mjs",
    "bench:parallel-latency": "node scripts/bench/parallel-latency.mjs",
    "bench:private-control": "node scripts/bench/parallel-private-control.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
