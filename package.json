{
  "name": "ring64",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "site:build": "node scripts/build/build-site.mjs",
    "site:dev": "node scripts/serve/site.mjs",
    "check": "node scripts/check/check.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "cargo fmt && prettier --write .",
    "format:check": "cargo fmt --check && prettier --check .",
    "test": "node --import tsx --test \"sdk/tests/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:browser": "node scripts/check/standalone-browser-check.mjs && node scripts/check/parallel-browser-check.mjs",
    "test:package": "node --test sdk/tests/package/package.test.mjs",
    "bench": "node scripts/bench/benchmark.mjs",
    "bench:parallel": "node scripts/bench/parallel-bench.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
