{
  "name": "ring64",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "site:build": "node scripts/build/build-site.mjs",
    "site:dev": "node scripts/serve/site.mjs",
    "site:typecheck": "tsc --project website/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "cargo fmt && prettier --write .",
    "format:check": "cargo fmt --check && prettier --check .",
    "check": "node scripts/check/check.mjs",
    "test": "node --import tsx --test \"sdk/tests/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:node:parallel": "node --import tsx --test tests/runners/parallel-node.test.ts",
    "test:browser:standalone": "node scripts/check/standalone-browser-check.mjs",
    "test:browser:parallel": "node scripts/check/parallel-browser-check.mjs",
    "test:package": "node --test sdk/tests/package/package.test.mjs",
    "test:mutations:parallel": "node scripts/check/parallel-mutations/parallel-mutation-check.mjs",
    "bench": "node scripts/bench/benchmark.mjs",
    "bench:parallel": "node scripts/bench/parallel-bench.mjs",
    "bench:parallel-latency": "node scripts/bench/parallel-latency.mjs",
    "bench:private-control": "node scripts/bench/parallel-private-control.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
